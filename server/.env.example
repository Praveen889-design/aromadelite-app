# --- Required in production ---
# A long random string used to sign JWT tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where to store the SQLite file. Defaults to ../database/aromadelite.db when not set.
# In a hosted environment, point this at a writable volume (e.g. /var/data/aromadelite.db).
DATABASE_PATH=

# --- Optional ---
# Port the API listens on. Most hosts (Railway/Render/Fly) inject PORT automatically.
PORT=5000

# How long a JWT remains valid. Default 8h.
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API. Use the Vercel
# preview + production URLs of the frontend, e.g.
#   https://aromadelite.vercel.app,https://aromadelite-git-main.vercel.app
# Set to "*" to allow any origin (not recommended).
CORS_ORIGIN=http://localhost:3000

# Set to "production" when running the built app behind a real host.
NODE_ENV=development
